@using DoAn.Models
@model List<SanPham>

@{
    ViewBag.Title = "DSSanPham";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>DSSanPham</h2>

@section naviheader
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Home</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/SanPham" class="nav-link">Sản phẩm</a>
        </li>
    </ul>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý Sản Phẩm</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        @Html.ActionLink("Home", "Index", "Home")
                    </li>
                    <li class="breadcrumb-item active">Sản phẩm</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Danh sách sản phẩm</h3>
            <div class="card-tools">
                @Html.ActionLink("Thêm mới", "ThemSP", "SanPham", null, new { @class = "btn btn-primary" })
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                            <th>Ngày tạo</th>
                            <th class="text-center">Tác vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr id="trow@item.Id">
                                <td>@(i + 1)</td>
                                <td>
                                    <img src="@Url.Content("~/" + item.DuongDanHinhAnh)" alt="Image" style="width:100px;height:auto;" />
                                </td>
                                <td>@item.TieuDe</td>
                                <td>@item.DanhMucSanPham.TieuDe</td>
                                <td>@item.SoLuong</td>
                                <td>@item.Gia</td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a href="@Url.Action("SuaSP", "SanPham", new { id = item.Id })" class="btn btn-primary btn-sm" style="margin-right: 5px;">Cập nhật</a>
                                    <a href="@Url.Action("XoaSP", "SanPham", new { id = item.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa?');">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Không có sản phẩm nào</p>
            }
        </div>
        <div class="card-footer">
            <!-- Có thể thêm thông tin hoặc tác vụ khác ở đây -->
        </div>
    </div>
</section>
