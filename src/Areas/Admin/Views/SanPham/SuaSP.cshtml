@using DoAn.Models
@model SanPham
@{
    ViewBag.Title = "SuaSP";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                <i class="fas fa-bars"></i>
            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Home</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/SanPham" class="nav-link">Sản phẩm</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="#" class="nav-link">Sửa sản phẩm</a>
        </li>
    </ul>
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="d-inline">Sửa sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Sản Phẩm</a></li>
                        <li class="breadcrumb-item active">Sửa sản phẩm</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="card">
            @*<div class="card-header">
                <h3 class="card-title">Thông tin sửa sản phẩm</h3>
            </div>*@
            <div class="card-body">
                @using (Html.BeginForm("SuaSP", "SanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.HiddenFor(m => m.Id)
                    <div class="form-group">
                        @Html.LabelFor(m => m.TieuDe, "Tên Sản Phẩm")
                        @Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.TieuDe, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.IdDanhMucSanPham, "Danh Mục Sản Phẩm")
                        @Html.DropDownListFor(m => m.IdDanhMucSanPham, (SelectList)ViewBag.DanhMucSanPham, "Chọn danh mục", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.IdDanhMucSanPham, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.MoTa, "Mô tả")
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.MoTa, "", new { @class = "text-danger" })
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.SoLuong, "Số lượng")
                                @Html.TextBoxFor(m => m.SoLuong, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Gia, "Giá")
                                @Html.TextBoxFor(m => m.Gia, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Gia, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.GiaKhuyenMai, "Giá Khuyến Mãi")
                                @Html.TextBoxFor(m => m.GiaKhuyenMai, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.GiaKhuyenMai, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-3">
                            <div class="form-group">
                                @Html.CheckBoxFor(x => x.HienThi, new { @class = "custom-control-input", @id = "customCheckbox1" })
                                <label for="customCheckbox1" class="custom-control-label">Hiển thị</label>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group">
                                @Html.CheckBoxFor(x => x.Hot, new { @class = "custom-control-input", @id = "customCheckbox2" })
                                <label for="customCheckbox2" class="custom-control-label">Hot</label>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group">
                                @Html.CheckBoxFor(x => x.NoiBat, new { @class = "custom-control-input", @id = "customCheckbox3" })
                                <label for="customCheckbox3" class="custom-control-label">Nổi bật</label>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group">
                                @Html.CheckBoxFor(x => x.KhuyenMai, new { @class = "custom-control-input", @id = "customCheckbox4" })
                                <label for="customCheckbox4" class="custom-control-label">Khuyến mãi</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Upload Image</label>
                        <input type="file" name="ImageFile" accept="image/*" />
                    </div>

                    <div>
                        <input type="submit" value="Sửa Sản Phẩm" class="btn btn-primary" />
                    </div>

                    @Html.ActionLink("Trở về", "DSSanPham", "SanPham", null, new { @class = "btn btn-secondary" })
                }
            </div>
            <div class="card-footer">
                Footer
            </div>
        </div>
    </section>
</div>
