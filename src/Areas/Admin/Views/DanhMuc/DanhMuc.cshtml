
@using DoAn.Models
@model List<DanhMuc>
@{
    ViewBag.Title = "Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Home</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/DanhMuc/DanhMuc" class="nav-link">Danh mục</a>
        </li>
    </ul>

}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý danh mục</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Danh mục </li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Danh sách danh mục </h3>

            <div class="card-tools">
                @*<a href="Admin/DanhMuc/ThemDM" class="btn btn-primary">Thêm mới</a>*@
                @Html.ActionLink("Thêm mới", "ThemDM", "DanhMuc", null, new { @class = "btn btn-primary" })


            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên danh mục</th>
                            <th>Thứ tự</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id </td>
                                <td>@item.TieuDe</td>
                                <td>@item.ViTri</td>
                                <td>

                                    @Html.ActionLink("Cập nhật", "SuaDM", "DanhMuc", new { id = item.Id }, new { @class = "btn btn-primary" })
                                    @Html.ActionLink("Xóa", "XoaDM", "DanhMuc", new { id = item.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Bạn có chắc chắn muốn xóa?');" })


                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            }
            else
            {
                <p>Không có danh mục nào</p>
            }
        </div>


        <!-- /.card-body -->
        <div class="card-footer">

        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->