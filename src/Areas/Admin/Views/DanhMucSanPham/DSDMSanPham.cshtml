@using DoAn.Models
@model List<DanhMucSanPham>

@{
    ViewBag.Title = "DSDMSanPham";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Home" class="nav-link">Home</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/DanhMuc/DanhMuc" class="nav-link">Danh mục</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/DanhMuc/DSDMSanPham" class="nav-link">Danh mục sản phẩm</a>
        </li>
    </ul>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý Danh Mục Sản Phẩm</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        @Html.ActionLink("Home", "Index", "Home")
                    </li>
                    <li class="breadcrumb-item active">Danh Mục Sản phẩm</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Danh sách sản phẩm</h3>
            <div class="card-tools">
                @Html.ActionLink("Thêm mới", "ThemDM", "DanhMucSanPham", null, new { @class = "btn btn-primary btn-sm" })
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên danh mục sản phẩm</th>
                            <th>Ngày tạo</th>
                            <th class="text-center">Tác vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr id="trow@item.Id">
                                <td>@(i + 1)</td>
                                <td>@item.TieuDe</td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a href="@Url.Action("SuaDMSP", "DanhMucSanPham", new { id = item.Id })" class="btn btn-primary btn-sm" style="margin-right: 5px;">Cập nhật</a>
                                    <a href="@Url.Action("XoaDM", "DanhMucSanPham", new { id = item.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa?');">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Không có sản phẩm nào</p>
            }
        </div>
        <!-- /.card-body -->
        <div class="card-footer">
            <!-- Có thể thêm thông tin hoặc tác vụ khác ở đây -->
        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->
</section>
<!-- /.content -->
