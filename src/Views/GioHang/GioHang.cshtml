@{
    ViewBag.Title = "Giỏ Hàng";
}
@model List<DoAn.Models.GioHang>

<div class="container mt-5">
    <div style="height: 100px;"></div>
    <h2 class="text-center">Giỏ Hàng</h2>

    @if (ViewBag.TongSoLuong == 0)
    {
        <div class="alert alert-warning" role="alert">
            Giỏ hàng của bạn hiện tại trống. Vui lòng thêm sản phẩm vào giỏ hàng!
        </div>
    }
    else
    {
        <form id="formGioHang" action="@Url.Action("CapNhatGioHang", "GioHang")" method="post">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)"></th>
                        <th>Mã sản phẩm</th>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="selectedItems" value="@item.IMaSP.ToString()" onclick="updateTotal()" />
                            </td>
                            <td>@item.IMaSP</td>
                            <td>
                                <img src="@Url.Content(item.SDuongDanHinhAnh)" alt="@item.STieuDes" style="width: 100px;" />
                                @item.STieuDes
                            </td>
                            <td>@String.Format("{0:N0}", item.DGia) VNĐ</td>
                            <td>
                                <input type="number" id="soLuong_@item.IMaSP" name="SoLuong_@item.IMaSP" value="@item.ISoLuong" min="1" style="width: 60px; text-align: center;" onchange="capNhatThanhTien(@item.IMaSP, @item.DGia)" />
                            </td>
                            <td id="thanhTien_@item.IMaSP" class="thanhTien">@String.Format("{0:N0}", item.dThanhTien) VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span style="font-size: 14px;">Tổng số lượng: @ViewBag.TongSoLuong</span>
                    <span style="font-size: 14px;"> | </span>
                    <span style="font-size: 14px;">Tổng thành tiền: <span id="totalAmount">@String.Format("{0:N0}", ViewBag.TongThanhTien)</span> VNĐ</span>

                </div>
            </div>
        </form>
        <div>
            <button type="button" class="btn btn-secondary" onclick="selectAll()">Chọn tất cả</button>
            <button type="button" class="btn btn-danger" onclick="clearCart()">Xóa tất cả</button>
        </div>
    }
    @using (Html.BeginForm("Checkout", "GioHang", FormMethod.Post))
    {


        <button type="submit" class="btn btn-primary">Thanh Toán</button>


    }
</div>

<script>
    function capNhatThanhTien(maSP, donGia) {
        var soLuongInput = document.getElementById('soLuong_' + maSP);
        var soLuong = parseInt(soLuongInput.value);

        // Tính thành tiền cho sản phẩm dựa trên số lượng và đơn giá
        var thanhTien = soLuong * donGia;

        // Cập nhật giá trị thành tiền vào ô tương ứng
        document.getElementById('thanhTien_' + maSP).textContent = thanhTien.toLocaleString('vi-VN') + ' VNĐ';

        // Cập nhật lại tổng thành tiền
        updateTotal();
    }

    function updateTotal() {
        const checkboxes = document.querySelectorAll('input[name="selectedItems"]:checked');
        let total = 0;

        checkboxes.forEach((checkbox) => {
            const row = checkbox.closest('tr');
            const priceText = row.querySelector('.thanhTien').textContent.trim();

            // Chuyển giá trị text về số bằng cách loại bỏ dấu phân cách hàng nghìn và ký tự VNĐ
            const price = parseFloat(priceText.replace(/[^0-9]/g, ''));

            total += price;
        });

        // Đảm bảo đúng id cho tổng thành tiền
        const totalElement = document.querySelector('#totalAmount');
        totalElement.textContent = total.toLocaleString('vi-VN') + ' VNĐ';
    }

    document.querySelectorAll('input[name="selectedItems"]').forEach(checkbox => {
        checkbox.addEventListener('change', updateTotal);
    });
    // Hàm để chọn hoặc bỏ chọn tất cả các checkbox
        function toggleSelectAll(selectAllCheckbox) {
        const checkboxes = document.querySelectorAll('input[name="selectedItems"]');
        checkboxes.forEach((checkbox) => {
            checkbox.checked = selectAllCheckbox.checked;
        });
        updateTotal();
    }

    function selectAll() {
        const selectAllCheckbox = document.getElementById('selectAllCheckbox');
        selectAllCheckbox.checked = true;
        toggleSelectAll(selectAllCheckbox);
    }

    function clearCart() {
    if (confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng không?')) {
        window.location.href = '@Url.Action("XoaGioHang_All", "GioHang")';
    }
}
</script>

<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
