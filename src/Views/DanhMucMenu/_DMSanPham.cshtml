@model IEnumerable<DoAn.Models.DanhMucSanPham>
@using System.Globalization
@using System.Text;
@using System.Text.RegularExpressions

<!-- Banner -->
<div class="banner">
    <h2 class="category-title">Danh mục sản phẩm</h2>
    <div class="container">
        <div class="row">
            @if (Model != null && Model.Any())
            {
                <ul class="navbar_menu" style="list-style-type: none; padding: 0; display: flex; flex-wrap: wrap;">
                    @foreach (var item in Model)
                    {
                        var duongdan = new string(item.TieuDe
                            .Normalize(NormalizationForm.FormD)
                            .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                            .ToArray());

                        // Chuyển đổi thành chữ thường và thay thế khoảng trắng bằng dấu gạch ngang
                        duongdan = duongdan.ToLower().Replace(" ", "-");

                        // Loại bỏ các ký tự không hợp lệ
                        duongdan = Regex.Replace(duongdan, @"[^a-z0-9\-]", "");
                        duongdan = Regex.Replace(duongdan, @"-{2,}", "-"); 
                        duongdan = duongdan.Trim('-');
                        duongdan = Regex.Replace(duongdan, @"(?<=\w)-(?=\w)", "");

                        <li class="col-md-4" style="flex: 0 0 33.33%; padding: 15px;">
                            <div class="banner_category" style="background-image:url('@Url.Content("~/Content/Assets/images/2.jpg")'); background-size: cover; background-repeat: no-repeat; height: 250px; border-radius: 8px; position: relative; overflow: hidden;">
                                <a href="@duongdan" class="category-link">@item.TieuDe</a>
                                <div class="overlay"></div>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Không có mục nào.</p>
            }
        </div>
    </div>
</div>
