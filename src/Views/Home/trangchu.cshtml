@{
    ViewBag.Title = "Trang Chủ";
}

<div style="height: 150px;"></div>

<!-- Main Slider Section -->
<div class="home-slider" style="background-image:url('@Url.Content("~/Content/Assets/images/new_slider_image.jpg")'); background-size: cover; height: 500px;">
    <div class="container h-100">
        <div class="row align-items-center h-100">
            <div class="col text-center text-white">
                <div class="slider-content">
                    <h6>Bộ sưu tập Thu / Đông 2024</h6>
                    <h1>Giảm đến 20% cho hàng mới về</h1>
                    <div class="btn-container">
                        <a href="shop.html" class="btn btn-primary">Mua ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Banner -->
@Html.Action("MenuTopSanPham", "DanhMucMenu")

<!-- New Arrivals -->
<div class="new-arrivals">
    <div class="container">
        @Html.Action("Arrivals", "DanhMucMenu")
    </div>
</div>

<!-- Deal of the Week -->
<div class="deal-week">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="deal-img">
                    <img src="images/deal_ofthe_week.png" alt="Deal of the Week" class="img-fluid">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="deal-content text-right">
                    <h2>Deal Of The Week</h2>
                    <ul class="timer d-flex justify-content-center">
                        <li><span class="timer-num">03</span> Day</li>
                        <li><span class="timer-num">15</span> Hours</li>
                        <li><span class="timer-num">45</span> Mins</li>
                        <li><span class="timer-num">23</span> Sec</li>
                    </ul>
                    <a href="#" class="btn btn-danger">Shop Now</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Best Sellers -->
<div class="best-sellers">
    <div class="container">
        <div class="section-title text-center">
            <h2>Best Sellers</h2>
        </div>
        <div class="product-slider owl-carousel owl-theme">
            <!-- Product Slide -->
            <div class="product-item">
                <img src="images/product_1.png" alt="Fujifilm X100T" class="img-fluid">
                <div class="product-info">
                    <h6><a href="single.html">Fujifilm X100T 16 MP Digital Camera</a></h6>
                    <div class="product-price">$520.00 <span>$590.00</span></div>
                </div>
            </div>
            <!-- More slides here... -->
        </div>
    </div>
</div>

<!-- Benefit Section -->
<div class="benefits">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="benefit-item">
                    <i class="fa fa-truck"></i>
                    <h6>Free Shipping</h6>
                    <p>Fast delivery to your location</p>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="benefit-item">
                    <i class="fa fa-money"></i>
                    <h6>Cash on Delivery</h6>
                    <p>Pay on receiving your order</p>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="benefit-item">
                    <i class="fa fa-undo"></i>
                    <h6>45 Days Return</h6>
                    <p>Easy returns within 45 days</p>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="benefit-item">
                    <i class="fa fa-clock-o"></i>
                    <h6>Open All Week</h6>
                    <p>8 AM - 9 PM</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Blogs Section -->
<div class="blogs">
    <div class="container">
        <div class="section-title text-center">
            <h2>Latest Blogs</h2>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <div class="blog-item">
                    <div class="blog-background" style="background-image:url(images/blog_1.jpg); background-size: cover;"></div>
                    <div class="blog-content">
                        <h4>Trends for Fall 2024</h4>
                        <span>by admin | Dec 01, 2017</span>
                        <a href="#" class="btn btn-link">Read More</a>
                    </div>
                </div>
            </div>
            <!-- More blog items here... -->
        </div>
    </div>
</div>

<!-- Account Section -->
<div class="account-section">
    <div class="container text-center">
        <h2>Tài Khoản Của Bạn</h2>
        <div class="auth-buttons">
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Đăng Nhập</a>
            <a href="@Url.Action("Register", "Account")" class="btn btn-secondary">Đăng Ký</a>
        </div>
    </div>
</div>
