@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="text-primary font-weight-bold">Chi tiết đơn hàng</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered shadow-lg">
            <thead class="thead-light">
                <tr>
                    <th style="width: 35%;">Tên sản phẩm</th>
                    <th style="width: 20%;">Hình ảnh </th>
                    <th style="width: 15%; text-align: center;">Số lượng</th>
                    <th style="width: 15%; text-align: center;">Đơn giá (VNĐ)</th>
                    <th style="width: 30%; text-align: center;">Thành tiền (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chiTiet in Model)
                {
                    <tr>
                        <td>@chiTiet.SanPham.TieuDe</td> <!-- Tên sản phẩm -->
                        <td>
                            <img src="@Url.Content("~/" + chiTiet.SanPham.DuongDanHinhAnh)" alt="Image" style="width:100px;height:auto;" />
                        </td>
                        <td class="text-center">@chiTiet.SoLuong</td> <!-- Số lượng -->
                        <td class="text-right">@String.Format("{0:N0}", chiTiet.Gia)</td> <!-- Đơn giá -->
                        <td class="text-right">@String.Format("{0:N0}", chiTiet.SoLuong * chiTiet.Gia)</td> <!-- Thành tiền -->
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-right mt-4">
        <a href="@Url.Action("DonHang", "DonHang")" class="btn btn-success btn-lg shadow-lg transition-btn">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách đơn hàng
        </a>
    </div>
</div>

<!-- Thêm CSS tùy chỉnh cho hiệu ứng đẹp -->
<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
        transform: scale(1.02);
        transition: all 0.3s ease-in-out;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .transition-btn {
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .transition-btn:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }
</style>
