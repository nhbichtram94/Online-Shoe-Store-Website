@{
    ViewBag.Title = "Liên Hệ";
}

<!-- Tạo khoảng cách -->
<div style="height: 100px;"></div>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="text-center">Liên Hệ với HIME Shop</h1>
            <p class="lead text-center">Chúng tôi luôn sẵn sàng lắng nghe ý kiến của bạn.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h2>Thông Tin Liên Hệ</h2>
            <p>Đơn vị: Trường Đại học Công Thương TP. Hồ Chí Minh</p>
            <p>Email: info@huit.edu.vn</p>
            <p>Điện thoại: 0283 8163 31</p>
            <p>Địa chỉ: 140 Lê Trọng Tấn, Phường Tây Thạnh, Quận Tân Phú, TP.HCM</p>
        </div>
        <div class="col-md-6">
            <h2>Thông Tin Nhóm</h2>
            <p>Tên đồ án: Website Bán Giày Dép HIME</p>
            <p>Tên nhóm: Vượt Lên Chính Mình</p>
            <p>Thành viên:</p>
            <ul>
                <li>Hồng Hà</li>
                <li>Bích Trâm</li>
                <li>Hoàng Lực</li>
                <li>Phụng Quyên</li>
            </ul>
        </div>
    </div>

    <hr>

    <div class="row mt-4">
        <div class="col-md-12">
            <h2>Gửi Thông Tin Liên Hệ</h2>
            <form>
                <div class="form-group">
                    <label for="name">Tên:</label>
                    <input type="text" class="form-control" id="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" class="form-control" id="email" required>
                </div>
                <div class="form-group">
                    <label for="message">Tin nhắn:</label>
                    <textarea class="form-control" id="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Gửi</button>
            </form>
        </div>
    </div>
</div>
