@model IEnumerable<DoAn.Models.SanPham>
@using System.Globalization
@using System.Text.RegularExpressions
@using System.Text

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var duongdan = new string(item.TieuDe
            .Normalize(NormalizationForm.FormD)
            .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            .ToArray());

        // Chuyển đổi thành chữ thường và thay thế khoảng trắng bằng dấu gạch ngang
        duongdan = duongdan.ToLower().Replace(" ", "-");

        // Loại bỏ các ký tự không hợp lệ
        duongdan = Regex.Replace(duongdan, @"[^a-z0-9\-]", "");

        // Loại bỏ dấu gạch ngang liên tiếp và ở đầu/cuối chuỗi
        duongdan = Regex.Replace(duongdan, @"-{2,}", "-").Trim('-');

        // Kiểm tra xem sản phẩm có hiển thị hay không
        if (item.HienThi)
        {
            <div class="product-item @item.IdDanhMucSanPham">
                <div class="product discount product_filter">
                    <div class="product_image">
                        <img src="@item.DuongDanHinhAnh" alt="@item.TieuDe" />
                    </div>
                    <div class="favorite favorite_left"></div>
                    <div class="product_bubble product_bubble_right product_bubble_red d-flex flex-column align-items-center">
                        <span>-$20</span> <!-- Có thể thay đổi nếu cần -->
                    </div>
                    <div class="product_info">
                        <h6 class="product_name"><a href="@duongdan">@item.TieuDe</a></h6>
                        <div class="product_price">
                            <span>@(item.KhuyenMai ? item.GiaKhuyenMai : item.Gia)</span>
                        </div>
                    </div>
                </div>
                <div class="red_button add_to_cart_button"><a href="#">Thêm vào giỏ hàng</a></div>
            </div>
        }
    }
}
else
{
    <p>Không có sản phẩm nào.</p>
}
