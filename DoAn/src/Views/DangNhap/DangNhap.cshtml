@using DoAn.Models;
@model KhachHang
@{
    ViewBag.Title = "Đăng Nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="height: 100px;"></div>
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">
    <div class="col-md-5 col-lg-4 login-form-container">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-body p-4">
                <h2 class="text-center mb-4" style="color: #333;">Đăng Nhập</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @using (Html.BeginForm("DangNhap", "DangNhap", FormMethod.Post, new { @class = "form-signin", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4 position-relative">
                        <input type="text" id="username" name="TAIKHOAN" class="login-input" placeholder="Tên tài khoản" autofocus />
                        @Html.ValidationMessageFor(m => m.TAIKHOAN, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4 position-relative">
                        <input type="password" id="password" name="MATKHAU" class="login-input" placeholder="Mật khẩu" />
                        @Html.ValidationMessageFor(m => m.MATKHAU, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill login-btn">Đăng Nhập</button>
                    </div>
                }

                <div class="text-center mt-3">
                    <p class="text-muted small">
                        Bạn chưa có tài khoản?
                        <a href="@Url.Action("DangKy", "NguoiDung")" class="text-decoration-none login-link">Đăng ký ngay</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    /* Chỉ áp dụng cho form đăng nhập */
    .login-form-container .login-input {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
        font-size: 16px;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

        .login-form-container .login-input:focus {
            border-color: #6a11cb;
            outline: none;
            box-shadow: 0 0 5px rgba(106, 17, 203, 0.5);
        }

        .login-form-container .login-input::placeholder {
            color: #aaa;
            font-style: italic;
        }

        .login-form-container .login-input:not(:focus):hover {
            border-color: #aaa;
        }

    .login-form-container .login-btn {
        background-color: #6a11cb;
        border: none;
        transition: background-color 0.3s;
    }

        .login-form-container .login-btn:hover {
            background-color: #5a0fb4;
        }

    .login-form-container .login-link {
        color: #2575fc;
        text-decoration: none;
    }

        .login-form-container .login-link:hover {
            text-decoration: underline;
        }
</style>
