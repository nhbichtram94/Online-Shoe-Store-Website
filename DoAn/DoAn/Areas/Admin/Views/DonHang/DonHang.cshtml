@model List<DoAn.Models.DonHang>
@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="text-primary font-weight-bold">Danh sách đơn hàng</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered shadow-lg">
            <thead class="thead-light">
                <tr>
                    <th style="width: 15%;">Mã đơn hàng</th>
                    <th style="width: 25%;">Tên khách hàng</th>
                    <th style="width: 20%;">Ngày đặt</th>
                  
                    <th style="width: 15%;">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donHang in Model)
                {
                    <tr>
                        <td>@donHang.MaDonHang</td>
                        <td>@donHang.KhachHang.TAIKHOAN</td> <!-- Tên khách hàng -->
                        <td>@donHang.NgayDat.ToString()</td> <!-- Ngày đặt -->
                     
                        <td>
                            <a href="@Url.Action("ChiTietDonHang", "DonHang", new { id = donHang.MaDonHang })" class="btn btn-info btn-sm">
                                Xem chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Thêm CSS tùy chỉnh cho hiệu ứng đẹp -->
<style>
    .table-hover tbody tr:hover {
        background-color: #f0f8ff;
        transform: scale(1.02);
        transition: all 0.3s ease-in-out;
    }

    .table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
        padding: 12px;
        font-weight: bold;
    }

    .table td {
        text-align: center;
        padding: 12px;
        font-size: 14px;
        vertical-align: middle;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: white;
        padding: 8px 16px;
        font-size: 14px;
        border-radius: 5px;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
        }

    .container {
        max-width: 1200px;
        margin-top: 50px;
    }

    h2 {
        font-size: 30px;
        font-weight: bold;
        color: #333;
    }

    .table-responsive {
        margin-top: 30px;
    }

    /* Thêm hiệu ứng bóng cho bảng */
    .table {
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* Định dạng lại đường viền của bảng */
    .table-bordered th, .table-bordered td {
        border: 1px solid #ddd;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }
</style>