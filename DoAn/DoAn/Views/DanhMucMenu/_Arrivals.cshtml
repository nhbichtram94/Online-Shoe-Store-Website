                    <li class="grid_sorting_button button d-flex flex-column justify-content-center align-items-center active is-checked" data-filter="*" data-id="all">all</li>
                    @*@foreach (var item in Model)
                    {
                        var duongdan = new string(item.TieuDe
.Normalize(NormalizationForm.FormD)
.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
.ToArray());

                        // Chuyển đổi thành chữ thường và thay thế khoảng trắng bằng dấu gạch ngang
                        duongdan = duongdan.ToLower().Replace(" ", "-");

                        // Loại bỏ các ký tự không hợp lệ (như %20)
                        duongdan = Regex.Replace(duongdan, @"[^a-z0-9\-]", ""); // Chỉ cho phép chữ cái, số và dấu gạch ngang

                        // Loại bỏ dấu gạch ngang liên tiếp
                        duongdan = Regex.Replace(duongdan, @"-{2,}", "-");
                        // Thay thế nhiều dấu gạch ngang bằng một dấu


                        // Loại bỏ dấu gạch ngang ở đầu và cuối chuỗi
                        duongdan = duongdan.Trim('-');
                        duongdan = Regex.Replace(duongdan, @"(?<=\w)-(?=\w)", "");*@

                        @*<li class="grid_sorting_button button d-flex flex-column justify-content-center align-items-center" data-filter="@("." + duongdan)">@item.TieuDe</li>


                    }*@
                </ul>
            </div>
        </div>
    </div>

        <div class="row">
            <div class="col">
                <div class="product-grid" data-isotope='{ "itemSelector": ".product-item", "layoutMode": "fitRows" }'>
                    @foreach (var danhMuc in Model)
                    {
                      
                        <h2>@danhMuc.TieuDe</h2> <!-- Hiển thị tên danh mục -->
                        @Html.Action("Partial_ItemId", "SanPham", new { id = danhMuc.Id }) <!-- Gọi action với id của danh mục -->
                    }
                </div>
            </div>
        </div>
    }

  

