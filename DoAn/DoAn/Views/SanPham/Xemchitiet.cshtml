@{
    ViewBag.Title = "Xem Chi Tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model DoAn.Models.SanPham

<div style="height: 100px;"></div>
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Url.Content(Model.DuongDanHinhAnh)" alt="@Model.TieuDe" class="img-fluid" style="max-width: 75%; height: auto; object-fit: cover; margin: 0 auto;" />
        </div>
        <div class="col-md-6">
            <h2 class="text-left" style="color: black;">@Model.TieuDe</h2>
            <p style="margin-top: 10px; color: black;"><strong>Mô tả:</strong> @Model.MoTa</p>
            <p style="margin-top: 10px; color: black;"><strong>Giá:</strong> @String.Format("{0:N0}", Model.Gia) VNĐ</p>
            @if (Model.GiaKhuyenMai > 0)
            {
                <p style="margin-top: 10px; color: black;"><strong>Giá Khuyến Mãi:</strong> @String.Format("{0:N0}", Model.GiaKhuyenMai) VNĐ</p>
            }
            <p style="margin-top: 10px; color: black;"><strong>Số Lượng:</strong> @Model.SoLuong</p>

            @if (Model.SoLuong > 0)
            {
                <div class="quantity-container mb-3">
                    <button class="quantity-btn" type="button" onclick="changeQuantity(-1)">&#8722;</button>
                    <input type="number" id="quantity" name="quantity" min="1" value="1" class="quantity-input" />
                    <button class="quantity-btn" type="button" onclick="changeQuantity(1)">&#43;</button>
                </div>

                <a href="javascript:void(0);" class="btn btn-success" style="margin-top: 10px;" onclick="addToCart(@Model.Id)">Thêm vào giỏ hàng</a>
                <!-- Thông báo thành công -->
                <div id="successMessage" class="alert alert-success" style="display:none;" role="alert">
                    Sản phẩm đã được thêm vào giỏ hàng!
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    Sản phẩm này đã hết hàng!
                </div>
            }
        </div>
    </div>
</div>

<style>
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .quantity-container {
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #ccc;
        border-radius: 5px;
        width: 150px;
    }

    .quantity-btn {
        background-color: #f0f0f0;
        border: none;
        padding: 10px;
        font-size: 18px;
        cursor: pointer;
        color: #333;
        width: 40px;
        text-align: center;
    }

        .quantity-btn:hover {
            background-color: #ddd;
        }

    .quantity-input {
        text-align: center;
        width: 60px;
        border: none;
        outline: none;
        font-size: 16px;
    }

    .quantity-container > *:not(:last-child) {
        margin-right: 5px;
    }
</style>

<script>
    function changeQuantity(amount) {
        var quantityInput = document.getElementById('quantity');
        var currentValue = parseInt(quantityInput.value);
        var newValue = currentValue + amount;

        if (newValue >= 1 && newValue <= @Model.SoLuong) {
            quantityInput.value = newValue;
        }
    }

    function addToCart(productId) {
        var quantity = document.getElementById('quantity').value;
        var strURL = '@Url.Action("ThemGioHang", "GioHang")?ms=' + productId + '&strURL=' + window.location.href;
        window.location.href = strURL + '&quantity=' + quantity;

        var successMessage = document.getElementById('successMessage');
        successMessage.style.display = 'block';
        setTimeout(function() {
            successMessage.style.display = 'none';
        }, 2000); 
    }
</script>

<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
